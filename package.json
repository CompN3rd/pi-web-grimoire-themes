{
  "name": "pi-web-grimoire-themes",
  "version": "0.4.0",
  "private": true,
  "description": "Six wizardly Pi Web palettes, each with Quiet and Spellbound motion editions.",
  "license": "MIT",
  "type": "module",
  "files": ["assets", "previews", "README.md", "MOTION.md", "LICENSE"],
  "scripts": { "test": "node --test test/*.test.mjs", "preview": "python3 -m http.server 4173 --bind 127.0.0.1" },
  "piWeb": {
    "plugins": [{
      "id": "grimoire",
