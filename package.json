        { "id": "candlelit", "name": "Candlelit Folio", "description": "Ivory parchment, oxblood ink, and quiet enchantment.", "colorScheme": "light", "order": 100, "stylesheets": [{ "id": "palette", "path": "candlelit.css", "order": 100 }, { "id": "manuscript", "path": "manuscript.css", "order": 200 }, { "id": "motion", "path": "motion.css", "order": 400 }] },
        { "id": "candlelit-spellbound", "name": "Candlelit Folio · Spellbound", "description": "The same volume with more theatrical, finite magical motion.", "colorScheme": "light", "order": 101, "stylesheets": [{ "id": "palette", "path": "candlelit.css", "order": 100 }, { "id": "manuscript", "path": "manuscript.css", "order": 200 }, { "id": "motion", "path": "motion.css", "order": 400 }, { "id": "spellbound", "path": "spellbound.css", "order": 500 }] },
        { "id": "astral", "name": "Astral Grimoire", "description": "Midnight vellum, lilac ink, and quiet enchantment.", "colorScheme": "dark", "order": 110, "stylesheets": [{ "id": "palette", "path": "astral.css", "order": 100 }, { "id": "manuscript", "path": "manuscript.css", "order": 200 }, { "id": "motion", "path": "motion.css", "order": 400 }] },
        { "id": "astral-spellbound", "name": "Astral Grimoire · Spellbound", "description": "The same volume with more theatrical, finite magical motion.", "colorScheme": "dark", "order": 111, "stylesheets": [{ "id": "palette", "path": "astral.css", "order": 100 }, { "id": "manuscript", "path": "manuscript.css", "order": 200 }, { "id": "motion", "path": "motion.css", "order": 400 }, { "id": "spellbound", "path": "spellbound.css", "order": 500 }] },
        { "id": "verdant", "name": "Verdant Codex", "description": "Forest leather, sage lettering, and quiet enchantment.", "colorScheme": "dark", "order": 120, "stylesheets": [{ "id": "palette", "path": "verdant.css", "order": 100 }, { "id": "manuscript", "path": "manuscript.css", "order": 200 }, { "id": "motion", "path": "motion.css", "order": 400 }] },
        { "id": "verdant-spellbound", "name": "Verdant Codex · Spellbound", "description": "The same volume with more theatrical, finite magical motion.", "colorScheme": "dark", "order": 121, "stylesheets": [{ "id": "palette", "path": "verdant.css", "order": 100 }, { "id": "manuscript", "path": "manuscript.css", "order": 200 }, { "id": "motion", "path": "motion.css", "order": 400 }, { "id": "spellbound", "path": "spellbound.css", "order": 500 }] },
        { "id": "hedgewitch", "name": "Hedgewitch’s Journal", "description": "Casual handwriting, mottled cream paper, and quiet enchantment.", "colorScheme": "light", "order": 130, "stylesheets": [{ "id": "palette", "path": "hedgewitch.css", "order": 100 }, { "id": "manuscript", "path": "manuscript.css", "order": 200 }, { "id": "paper", "path": "paper.css", "order": 300 }, { "id": "motion", "path": "motion.css", "order": 400 }] },
        { "id": "hedgewitch-spellbound", "name": "Hedgewitch’s Journal · Spellbound", "description": "The same volume with more theatrical, finite magical motion.", "colorScheme": "light", "order": 131, "stylesheets": [{ "id": "palette", "path": "hedgewitch.css", "order": 100 }, { "id": "manuscript", "path": "manuscript.css", "order": 200 }, { "id": "paper", "path": "paper.css", "order": 300 }, { "id": "motion", "path": "motion.css", "order": 400 }, { "id": "spellbound", "path": "spellbound.css", "order": 500 }] },
        { "id": "scribe", "name": "Scribe’s Spellbook", "description": "Calligraphic ink, golden parchment, and quiet enchantment.", "colorScheme": "light", "order": 140, "stylesheets": [{ "id": "palette", "path": "scribe.css", "order": 100 }, { "id": "manuscript", "path": "manuscript.css", "order": 200 }, { "id": "paper", "path": "paper.css", "order": 300 }, { "id": "motion", "path": "motion.css", "order": 400 }] },
